---
import { KINSTA_AFFILIATE_URL } from '../config/affiliate';

interface Props {
  label?: string;
}

const { label = 'Explore Kinsta WordPress hosting' } = Astro.props;
---

<aside class="kinsta-cta" aria-label="Hosting option">
  <p>Considering managed WordPress hosting? Compare your requirements and budget before choosing a provider.</p>
  <a href={KINSTA_AFFILIATE_URL} rel="sponsored nofollow">{label}</a>
  <p><small>Affiliate link — I may earn a commission if you sign up through this link.</small></p>
</aside>

<style lang="scss">
  .kinsta-cta {
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-block: 2rem;
  }
</style>
