{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "heroImage": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "type": "boolean"
    },
    "affiliate": {
      "type": "string",
      "const": "kinsta"
    },
    "aiGenerated": {
      "default": false,
      "type": "boolean"
    },
    "targetKeyword": {
      "type": "string",
      "minLength": 1
    },
    "searchIntent": {
      "type": "string",
      "enum": [
        "informational",
        "commercial",
        "transactional"
      ]
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "url",
          "title",
          "checkedAt"
        ]
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "factsChecked": {
          "type": "boolean",
          "const": true
        },
        "originalContent": {
          "type": "boolean",
          "const": true
        },
        "noInventedExperience": {
          "type": "boolean",
          "const": true
        },
        "readerValueChecked": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "approvedBy",
        "approvedAt",
        "factsChecked",
        "originalContent",
        "noInventedExperience",
        "readerValueChecked"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate"
  ]
}